# Copy this file to .env and fill it in. The .env file is ignored by git.

# The MessageOS API address. Leave it as it is unless MessageOS gave you another one.
MESSAGEOS_API_URL=https://api.messageos.ai/v1

# Your client key. It starts with mosc_ and is shown once, when it is made in the dashboard under Developers.
# It needs these permissions: messages:write, contacts:read, contacts:write, conversations:read,
# webhooks:manage, usage:read.
MESSAGEOS_API_KEY=

# The signing secret of your webhook. "npm run setup:webhook" prints it once when it makes the webhook.
MESSAGEOS_WEBHOOK_SECRET=

# This app's own public https address, with no path. Picture and file links are built from it, and the
# webhook is registered at <PUBLIC_URL>/webhooks/messageos. On your own computer, use the address of a
# public https tunnel that forwards to PORT.
PUBLIC_URL=

# The port the local server listens on.
PORT=3000
